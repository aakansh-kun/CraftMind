# ==============================================================================
# CraftMind Environment Configuration Template
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit real API keys to version control.
# ==============================================================================

# LLM Provider API Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# LLM Model Identifiers
GEMINI_MODEL=gemini/gemini-flash-lite-latest
GROQ_MODEL=groq/openai/gpt-oss-120b

# Key Mapping Configuration (key_1 = Gemini, key_2 = Groq)
LLM_API_KEYS=key_1:gemini,key_2:groq

# Database Configuration
# Default for Docker is /data/app.db.
# For local running without Docker, backend automatically falls back to ./data/app.db if /data is not writable.
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins (comma-separated for multiple origins, e.g. http://localhost:3000,https://craftmind.example.com)
ALLOWED_ORIGINS=http://localhost:3000

# Testing and Failure Simulation
ENABLE_FAILURE_SIMULATION=true

# LiteLLM Cache Setting
ENABLE_CACHE=true

# Frontend API URL Configuration (passed to frontend at build time or via .env)
VITE_API_URL=http://localhost:8000
